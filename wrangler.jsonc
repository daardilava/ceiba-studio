// Cloudflare Workers deployment: an assets-only Worker serving the static export in out/.
// There is no Worker script, so no server code runs; _headers and _redirects in out/ still apply.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ceiba-studio",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./out",
    // Serve out/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page",
    // Matches trailingSlash: true in next.config.ts (/en/mitimiti → /en/mitimiti/).
    "html_handling": "auto-trailing-slash",
  },
}
